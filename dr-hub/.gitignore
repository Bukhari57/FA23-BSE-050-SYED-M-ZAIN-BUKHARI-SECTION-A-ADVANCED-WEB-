# Dependencies
node_modules/
*/node_modules/

# Environment variables — NEVER commit these
.env
.env.local
.env.production
backend/.env
frontend/.env
frontend/.env.local

# Build output
frontend/dist/
frontend/build/

# Vercel
.vercel/
*/vercel/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Editor
.vscode/settings.json
.idea/

# Uploads (local dev only — production uses Supabase Storage)
backend/src/uploads/*.jpg
backend/src/uploads/*.jpeg
backend/src/uploads/*.png
backend/src/uploads/*.pdf
!backend/src/uploads/.gitkeep

# Temp
__MACOSX/
*.zip
