{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "env": {
    "VITE_API_URL": "@vite-api-url"
  },
  "functions": {
    "backend/**/*.js": {
      "runtime": "nodejs18.x",
      "environment": {
        "NODE_ENV": "production"
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    }
  ]
}
